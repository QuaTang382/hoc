{
  "entities": {
    "SharedQuiz": {
      "title": "SharedQuiz",
      "description": "A quiz shared via a short code.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the quiz" },
        "description": { "type": "string", "description": "Description of the quiz" },
        "questions": {
          "type": "array",
          "description": "List of questions",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": {
                "type": "array",
                "items": { "type": "string" }
              },
              "correctAnswer": { "type": "number" },
              "explanation": { "type": "string" }
            },
            "required": ["question", "options", "correctAnswer", "explanation"]
          }
        },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["title", "description", "questions", "createdAt"]
    },
    "PublicQuiz": {
      "title": "PublicQuiz",
      "description": "A quiz published to the community.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the quiz" },
        "description": { "type": "string", "description": "Description of the quiz" },
        "questions": {
          "type": "array",
          "description": "List of questions",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": {
                "type": "array",
                "items": { "type": "string" }
              },
              "correctAnswer": { "type": "number" },
              "explanation": { "type": "string" }
            },
            "required": ["question", "options", "correctAnswer", "explanation"]
          }
        },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "authorUid": { "type": "string", "description": "UID of the author" },
        "authorName": { "type": "string", "description": "Name of the author" },
        "authorPhoto": { "type": "string", "description": "Photo URL of the author" },
        "playCount": { "type": "number", "description": "Number of times played" },
        "color": { "type": "string", "description": "Theme color" },
        "likes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Array of user UIDs who liked the quiz"
        }
      },
      "required": ["title", "description", "questions", "createdAt", "authorUid", "authorName", "playCount"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a public quiz.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "Comment text" },
        "authorUid": { "type": "string", "description": "UID of the author" },
        "authorName": { "type": "string", "description": "Name of the author" },
        "authorPhoto": { "type": "string", "description": "Photo URL of the author" },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["text", "authorUid", "authorName", "createdAt"]
    },
    "UserScore": {
      "title": "UserScore",
      "description": "User's total score for the leaderboard.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User photo URL" },
        "totalScore": { "type": "number", "description": "Total correct answers" }
      },
      "required": ["uid", "displayName", "totalScore"]
    }
  },
  "firestore": {
    "/shared_quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/SharedQuiz" },
      "description": "Collection of shared quizzes accessible by short code."
    },
    "/public_quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/PublicQuiz" },
      "description": "Collection of public quizzes available to the community."
    },
    "/public_quizzes/{quizId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Stores comments for a public quiz."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserScore" },
      "description": "Collection of user scores for the leaderboard."
    }
  }
}
